{
  // The site is static, so the Worker has no `main`: Cloudflare serves the
  // assets directly, and no code of ours runs on a request.
  "name": "rustaceans-ai",
  "compatibility_date": "2026-09-03",
  // The Worker answers on the custom domain that den attaches to it. A
  // workers.dev hostname would be a second public origin serving the same
  // site.
  "workers_dev": false,
  // Previews are off. A preview URL would be one more public origin, and
  // nothing in den restricts access to it.
  "preview_urls": false,
  "assets": {
    // The site has no build step, and it lives in the root of the repository.
    // `.assetsignore` names the files in that root that are not part of it.
    "directory": ".",
  },
}
